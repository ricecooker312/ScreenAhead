# Base URL of the CareCompass API.
# Android emulator: http://10.0.2.2:4000  ·  iOS simulator: http://localhost:4000  ·  Device: http://<your-LAN-IP>:4000
# Production must use https://
EXPO_PUBLIC_API_URL=http://localhost:4000
# Emergency number shown in the app (change for other countries, e.g. 999, 112, 000)
EXPO_PUBLIC_EMERGENCY_NUMBER=911
