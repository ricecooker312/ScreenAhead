# ---- CareCompass API configuration (example values only — never commit real secrets) ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (mobile apps do not need CORS)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

MONGODB_URI=mongodb://127.0.0.1:27017/carecompass

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Public link used in password-reset emails (deep link or web page)
PASSWORD_RESET_URL=carecompass://reset-password
PASSWORD_RESET_TTL_MINUTES=30

# Email: "console" logs a redacted notice in development. "smtp" requires the SMTP_* values.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CareCompass <no-reply@example.org>"

# Set to true only behind a TLS-terminating proxy (load balancer, ingress)
TRUST_PROXY=false
# Serve Swagger UI at /api/docs
ENABLE_API_DOCS=true
LOG_LEVEL=info

# Data retention (days). Audit logs keep no health details.
AUDIT_LOG_RETENTION_DAYS=2190
SHARE_CODE_TTL_HOURS=24

# Optional AI explanation layer — disabled until privacy/legal review and a BAA are in place
AI_PROVIDER=disabled
AI_API_KEY=
